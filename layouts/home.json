{{- $items := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
{{- $items = $items | append (dict "title" .Title "url" .RelPermalink "date" (.Date.Format "2006-01-02") "summary" (.Summary | plainify) "tags" (.Params.tags | default slice) "outcome" (.Params.outcome | default "")) -}}
{{- end -}}
{{- $items | jsonify -}}
